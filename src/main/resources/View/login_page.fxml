<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="340.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.LoginPageController">
   <children>
      <Label fx:id="Lable_1" layoutX="8.0" layoutY="28.0" prefHeight="36.0" prefWidth="320.0" text="Library Management System">
         <font>
            <Font name="System Bold" size="23.0" />
         </font>
      </Label>
      <Label fx:id="Lable_2" layoutX="112.0" layoutY="80.0" text="Librarian Login">
         <font>
            <Font name="System Italic" size="18.0" />
         </font>
      </Label>
      <Label fx:id="lblUserName" layoutX="24.0" layoutY="122.0" text="UserName:">
         <font>
            <Font name="Agency FB Bold" size="18.0" />
         </font>
      </Label>
      <Label fx:id="lblPassword" layoutX="24.0" layoutY="206.0" text="Password:">
         <font>
            <Font name="Agency FB Bold" size="17.0" />
         </font>
      </Label>
      <TextField fx:id="txtUserName" layoutX="24.0" layoutY="150.0" prefHeight="36.0" prefWidth="272.0" />
      <PasswordField fx:id="txtPassword" layoutX="24.0" layoutY="227.0" prefHeight="36.0" prefWidth="272.0" />
      <Button fx:id="btnLogin" layoutX="24.0" layoutY="337.0" mnemonicParsing="false" onAction="#btnLoginOnAction" text="Login" textFill="#00000b" />
      <Button fx:id="btnClear" layoutX="86.0" layoutY="337.0" mnemonicParsing="false" onAction="#btnClearOnAction" text="Clear" />
      <Label fx:id="lblIncorrect" layoutX="9.0" layoutY="294.0" onDragDetected="#lblIncorrectOnAction" prefHeight="26.0" prefWidth="320.0" textFill="#e61212">
         <font>
            <Font size="15.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
